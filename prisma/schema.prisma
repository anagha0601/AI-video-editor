generator client {
  provider = "prisma-client-js"
}

// Postgres everywhere: docker-compose locally, Neon in production.
// The Python worker (worker/db.py) reads/writes VoiceTrack, RenderJob, MediaAsset,
// Project and TimelineVersion with raw SQL, so renaming columns here means updating it too.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  projects     Project[]
  assets       MediaAsset[]
  renders      RenderJob[]
}

model Project {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  aspect        String            @default("9:16") // "9:16" | "16:9" | "1:1"
  // draft -> transcribing -> transcribed -> building -> ready -> rendered; or failed
  status        String            @default("draft")
  statusMessage String?
  thumbnailUrl  String?
  duration      Float             @default(0)
  isSample      Boolean           @default(false)
  buildStartedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  voice         VoiceTrack?
  timeline      Timeline?
  versions      TimelineVersion[]
  renders       RenderJob[]

  @@index([userId, updatedAt])
}

model VoiceTrack {
  id             String    @id @default(cuid())
  projectId      String    @unique
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId        String?
  url            String
  duration       Float?
  language       String?
  transcriptJson Json? // { language, duration, words: [{ id, text, start, end }] }
  status         String    @default("queued") // queued | processing | done | failed
  error          String?
  attempts       Int       @default(0)
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

model Timeline {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  json      Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model TimelineVersion {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  kind      String      @default("manual") // manual | render | first-cut | before-restore
  json      Json
  createdAt DateTime    @default(now())
  renders   RenderJob[]

  @@index([projectId, createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // video | image | audio (voice) | music
  source    String   @default("upload") // upload | recording | pexels | sample
  key       String? // storage key when we host the file
  url       String
  thumbUrl  String?
  name      String
  mime      String?
  duration  Float?
  width     Int?
  height    Int?
  tags      String[]
  meta      Json? // { peaks, peaksPerSec, pexelsId, author, hasAudio }
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

model RenderJob {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId  String
  version    TimelineVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quality    String          @default("1080p") // 720p | 1080p
  status     String          @default("queued") // queued | processing | done | failed
  progress   Float           @default(0)
  outputUrl  String?
  outputKey  String?
  thumbUrl   String?
  duration   Float?
  error      String?
  attempts   Int             @default(0)
  lockedAt   DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([status, createdAt])
  @@index([projectId, createdAt])
}
