generator client {
  provider = "prisma-client-js"
}

// Postgres everywhere: docker-compose locally, Neon in production.
// The Python worker (worker/db.py) reads/writes VoiceTrack, RenderJob, MediaAsset,
// Project and TimelineVersion with raw SQL, so renaming columns here means updating it too.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  projects     Project[]
  assets       MediaAsset[]
  renders      RenderJob[]
  agentJobs    AgentJob[]
}

model Project {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  aspect        String            @default("9:16") // "9:16" | "16:9" | "1:1"
  // draft -> transcribing -> transcribed -> building -> ready -> rendered; or failed
  // edit modes: planning -> review (-> planning on feedback) -> ready; plan_failed
  status        String            @default("draft")
  statusMessage String?
  thumbnailUrl  String?
  duration      Float             @default(0)
  isSample      Boolean           @default(false)
  // voice = the voice-first auto first cut; the edit modes plan with Claude first (src/server/modes.ts):
  // music | talking_head | best_take | voiceover_broll | auto_clip
  mode          String            @default("voice")
  inputs        Json? // edit modes: { [role]: assetId | assetId[], options } chosen on the new-edit page
  plan          Json? // edit modes: the current plan.json (as the user edited it); status planning -> review -> ready
  planJobId     String?
  parentId      String? // auto-clip: the long-video project a short was cut from
  prompt        String? // the idea or script text for idea/script projects
  // Where scene visuals come from after the user's own media:
  // auto = library -> stock -> AI images; ai = AI images; stock = library -> stock
  visualMode    String            @default("auto")
  assetIds      String[] // photos/videos the user attached to this project (used first)
  buildStartedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  voice         VoiceTrack?
  timeline      Timeline?
  versions      TimelineVersion[]
  renders       RenderJob[]
  agentJobs     AgentJob[]

  @@index([userId, updatedAt])
}

model VoiceTrack {
  id             String    @id @default(cuid())
  projectId      String    @unique
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId        String?
  url            String
  duration       Float?
  language       String?
  transcriptJson Json? // { language, duration, words: [{ id, text, start, end }] }
  status         String    @default("queued") // queued | processing | done | failed
  error          String?
  attempts       Int       @default(0)
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

model Timeline {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  json      Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
}

model TimelineVersion {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  kind      String      @default("manual") // manual | render | first-cut | before-restore
  json      Json
  createdAt DateTime    @default(now())
  renders   RenderJob[]

  @@index([projectId, createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // video | image | audio (voice) | music
  source    String   @default("upload") // upload | recording | pexels | sample
  key       String? // storage key when we host the file
  url       String
  thumbUrl  String?
  name      String
  mime      String?
  duration  Float?
  width     Int?
  height    Int?
  tags      String[]
  meta      Json? // { peaks, peaksPerSec, pexelsId, author, hasAudio }
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

model RenderJob {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId  String
  version    TimelineVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quality    String          @default("1080p") // 720p | 1080p
  status     String          @default("queued") // queued | processing | done | failed
  progress   Float           @default(0)
  outputUrl  String?
  outputKey  String?
  thumbUrl   String?
  duration   Float?
  error      String?
  // checks on the exported file (worker/audio_master.py: loudness, true peak, clipping)
  report     Json?
  attempts   Int             @default(0)
  lockedAt   DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([status, createdAt])
  @@index([projectId, createdAt])
}

// One headless `claude -p` run (or a resumed turn of one). The agent runner
// (agent/runner.ts) claims queued rows one at a time; the full stream-json log is
// written to logPath, and structured results to outputFile in the project folder.
model AgentJob {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            String // selftest | ai_edit | enhance | upscale | ...
  exec            String? // JSON argv: a local command job (no claude), e.g. a Real-ESRGAN upscale
  title           String
  status          String    @default("queued") // queued | running | done | failed | cancelled
  prompt          String
  sessionId       String // claude session id: new sessions use --session-id, resumed ones --resume
  resume          Boolean   @default(false)
  outputFile      String? // relative to the project folder, e.g. "media-check.json"
  schema          String? // schema name in src/agent/schemas.ts
  timeoutSec      Int       @default(900)
  cancelRequested Boolean   @default(false)
  pid             Int?
  error           String?
  resultText      String?
  costUsd         Float? // claude's usage estimate; not billed on a subscription
  turns           Int?
  fixAttempts     Int       @default(0)
  logPath         String
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([status, createdAt])
  @@index([projectId, createdAt])
}
