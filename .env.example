# ReelSmith settings. setup.bat copies this file to .env and fills in the paths for this computer.
# Lines setup.ps1 manages are marked (setup). Re-running setup keeps values you have changed.

# ---------- Database (Postgres) ----------
# Native PostgreSQL: scripts/setup-local-db.ps1 creates this role/database. Docker: `docker compose up -d db` (port 5433).
DATABASE_URL="postgresql://reelsmith:reelsmith@localhost:5432/reelsmith"

# ---------- Auth.js ----------
# (setup) generated per install. Manual: npx auth secret
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------- Folders (setup) ----------
# Everything that isn't code lives outside the checkout. Defaults: %USERPROFILE%\ReelSmith\...
# (C:\ReelSmith\... when the profile path contains spaces, because Claude's permission rules can't match quoted paths)
# REELSMITH_DIR=""        # this checkout (the Python engine is in worker/)
# REEL_STUDIO_DIR=""      # Claude Code workspace: rules.md, CLAUDE.md, tools/, .claude/skills/ (video-use + edit-reel)
# STYLE_DIR=""            # reference reels Claude may read for style
# STORAGE_DIR=""          # uploads, projects (studio/<id>/), renders, caches

# ---------- Claude (agent runner) ----------
# Every AI step runs as a headless Claude Code job on your Claude subscription: start the runner with
#   npm run agent
# and log in once with `claude` (Pro/Max). Do NOT set ANTHROPIC_API_KEY: it would bill the API (the runner strips it).
# CLAUDE_MODEL=""         # optional model override for headless runs
# CLAUDE_BIN=""           # path to claude.exe if it isn't found automatically
# PYTHON_BIN=""           # (setup) the worker venv's python.exe: numpy, yt-dlp, faster-whisper

# ---------- AI upscale (optional) ----------
# setup installs realesrgan-ncnn-vulkan into REEL_STUDIO_DIR\tools\realesrgan. Slow on CPU; the app asks before running it.
# REALESRGAN_BIN=""
# REALESRGAN_GPU="-1"     # -1 = CPU; 0 = first GPU

# ---------- Storage driver ----------
# Leave the R2 vars empty to store files in STORAGE_DIR (served by /api/files).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""          # e.g. https://pub-xxxx.r2.dev or https://media.example.com
# STORAGE_DRIVER="local"  # force a driver (local | r2)

# ---------- Worker ----------
WHISPER_MODEL="base"      # tiny | base | small | medium | large-v3 (bigger = better + slower); setup pre-downloads it
# WHISPER_DEVICE="auto"   # cpu | cuda
# WHISPER_COMPUTE_TYPE="int8"
# WEB_URL="http://localhost:3000"   # worker fetches relative URLs (e.g. /sample/voice.m4a) from here if not on disk
# WORKER_POLL_SECONDS="2"
# X264_PRESET="slow"
