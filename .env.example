# Database (SQLite locally; Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Session signing secret - generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL (used for Stripe redirects)
APP_URL="http://localhost:3000"

# --- AI (optional: app runs in demo mode without it) ---
# Gemini (free tier): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Or Claude (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=""

# --- Stock visuals (optional: falls back to generated gradient art) ---
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=""

# --- AI voiceover (optional: falls back to browser text-to-speech preview) ---
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
