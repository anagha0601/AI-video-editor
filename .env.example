# ---------- Database (Postgres) ----------
# docker compose up -d db  ->  local Postgres on port 5433
DATABASE_URL="postgresql://reelsmith:reelsmith@localhost:5433/reelsmith"

# ---------- Auth.js ----------
# Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------- AI ----------
# Gemini (Flash, paid tier recommended): scene splitting, media tags, AI edit commands.
# Without it: heuristic scene split, no auto-tags, AI edits disabled.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ---------- Stock visuals ----------
# Free key: https://www.pexels.com/api/  Without it, scenes with no library match get gradient cards.
PEXELS_API_KEY=""

# ---------- Storage ----------
# Leave the R2 vars empty to store files in ./storage (served by /api/files).
# Cloudflare R2 (production): create a bucket + API token, enable public access (r2.dev or custom domain).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""          # e.g. https://pub-xxxx.r2.dev or https://media.example.com
# STORAGE_DRIVER="local"  # force a driver (local | r2)
# STORAGE_DIR="./storage" # local driver folder (shared with the worker)

# ---------- Usage & budget ----------
# Monthly Gemini budget in USD. The app shows a warning banner at 80% and 100%.
# Prices per model live in src/config/pricing.ts.
MONTHLY_BUDGET_USD="20"

# ---------- Worker ----------
WHISPER_MODEL="base"      # tiny | base | small | medium | large-v3 (bigger = better + slower)
# WHISPER_DEVICE="auto"   # cpu | cuda
# WHISPER_COMPUTE_TYPE="int8"
# WEB_URL="http://localhost:3000"   # worker fetches relative URLs (e.g. /sample/voice.m4a) from here if not on disk
# WORKER_POLL_SECONDS="2"
# X264_PRESET="veryfast"
